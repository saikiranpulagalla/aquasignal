# AquaSignal runs its deterministic verification demo without any API key.
# Set a stable secret for deployed/multi-worker instances so authority tokens survive
# process restarts and are shared across workers.
AQUASIGNAL_ENV=development
AQUASIGNAL_AUTHORITY_SECRET=
AQUASIGNAL_MAX_ADVISORY_CHARS=8000
AQUASIGNAL_MAX_REQUEST_BYTES=2500000

# Optional proposal-only AI rewrite. AI never participates in the PASS/BLOCK authority path.
AQUASIGNAL_REWRITE_ENABLED=false
AQUASIGNAL_REWRITE_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Legacy SignalLock provider/evaluation settings retained only for the inherited core.
SIGNALLOCK_PROVIDER=heuristic
SIGNALLOCK_MAX_ALERT_CHARS=12000
SIGNALLOCK_AUTHORITY_SECRET=
SIGNALLOCK_LIVE_PROVIDER_TOKEN=
SIGNALLOCK_TRUSTED_RUNTIME_SHA256=
ADAPTION_API_KEY=
